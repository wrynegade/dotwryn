_COLORSCHEME_FILE__gtk3="${DOTWRYN}/config/user/gtk-3.0/gtk.css"
_COLORSCHEME_FILE__gtk4="${DOTWRYN}/config/user/gtk-4.0/gtk.css"

# recolors libadwaita (GTK4) and the adw-gtk3 theme (GTK3) through their shared
# named colors; requires gtk-theme-name=adw-gtk3-dark (config/user/gtk-3.0/settings.ini)
#
# libadwaita draws text from one surface over another (e.g. notebook pages paint the
# view background but inherit the window foreground), so every surface shares the
# theme foreground and is the theme background tinted toward a material color; the
# only bg/fg pairs are the material ones (accent + status colors)
_GENERATE_THEME__gtk() {
	local css="/* do not edit; generated by scwrypts
 * theme : ${theme_name}
 */

@define-color view_bg_color          #$(_GET_HEX .gtk.view.bg .background);
@define-color view_fg_color          #$(_GET_HEX .gtk.view.fg .foreground);

@define-color window_bg_color        mix(@view_bg_color, #$(_GET_HEX .gtk.window.tint    .material.base.secondary .ansi.green.regular ), 0.10);
@define-color window_fg_color        @view_fg_color;

@define-color headerbar_bg_color     mix(@view_bg_color, #$(_GET_HEX .gtk.headerbar.tint .material.base.primary   .ansi.yellow.regular), 0.25);
@define-color headerbar_fg_color     @view_fg_color;
@define-color headerbar_border_color @view_fg_color;
@define-color headerbar_backdrop_color @window_bg_color;
@define-color headerbar_shade_color  rgba(0, 0, 0, 0.36);
@define-color headerbar_darker_shade_color rgba(0, 0, 0, 0.9);

@define-color sidebar_bg_color       mix(@view_bg_color, @window_bg_color, 0.6);
@define-color sidebar_fg_color       @view_fg_color;
@define-color sidebar_backdrop_color @view_bg_color;
@define-color sidebar_shade_color    rgba(0, 0, 0, 0.25);
@define-color secondary_sidebar_bg_color @view_bg_color;
@define-color secondary_sidebar_fg_color @view_fg_color;

@define-color card_bg_color          alpha(@view_fg_color, 0.05);
@define-color card_fg_color          @view_fg_color;
@define-color card_shade_color       rgba(0, 0, 0, 0.36);

@define-color dialog_bg_color        mix(@view_bg_color, @headerbar_bg_color, 0.6);
@define-color dialog_fg_color        @view_fg_color;

@define-color popover_bg_color       mix(@view_bg_color, @headerbar_bg_color, 0.6);
@define-color popover_fg_color       @view_fg_color;
@define-color popover_shade_color    rgba(0, 0, 0, 0.25);

@define-color thumbnail_bg_color     @window_bg_color;
@define-color thumbnail_fg_color     @view_fg_color;

@define-color shade_color            rgba(0, 0, 0, 0.36);
@define-color scrollbar_outline_color rgba(0, 0, 0, 0.5);

@define-color accent_color           #$(_GET_HEX .gtk.accent.color      .material.secondary.200             .ansi.green.bright  );
@define-color accent_bg_color        #$(_GET_HEX .gtk.accent.bg         .material.base.secondary            .ansi.green.regular );
@define-color accent_fg_color        #$(_GET_HEX .gtk.accent.fg         .material.base.foreground.secondary .ansi.gray.white    );

@define-color destructive_color      #$(_GET_HEX .gtk.destructive.color .material.error.200                 .ansi.red.bright    );
@define-color destructive_bg_color   #$(_GET_HEX .gtk.destructive.bg    .material.base.error                .ansi.red.regular   );
@define-color destructive_fg_color   #$(_GET_HEX .gtk.destructive.fg    .material.base.foreground.error     .ansi.gray.white    );

@define-color success_color          #$(_GET_HEX .gtk.success.color     .material.secondary.200             .ansi.green.bright  );
@define-color success_bg_color       #$(_GET_HEX .gtk.success.bg        .material.base.secondary            .ansi.green.regular );
@define-color success_fg_color       #$(_GET_HEX .gtk.success.fg        .material.base.foreground.secondary .ansi.gray.white    );

@define-color warning_color          #$(_GET_HEX .gtk.warning.color     .material.primary.200               .ansi.yellow.bright );
@define-color warning_bg_color       #$(_GET_HEX .gtk.warning.bg        .material.base.primary              .ansi.yellow.regular);
@define-color warning_fg_color       #$(_GET_HEX .gtk.warning.fg        .material.base.foreground.primary   .ansi.gray.white    );

@define-color error_color            #$(_GET_HEX .gtk.error.color       .material.error.200                 .ansi.red.bright    );
@define-color error_bg_color         #$(_GET_HEX .gtk.error.bg          .material.base.error                .ansi.red.regular   );
@define-color error_fg_color         #$(_GET_HEX .gtk.error.fg          .material.base.foreground.error     .ansi.gray.white    );"

	# adw-gtk3 pins the GTK4 accent to the system accent-color (libadwaita-tweaks.css)
	local gtk4_accent="
:root {
	--accent-color:    @accent_color;
	--accent-bg-color: @accent_bg_color;
	--accent-fg-color: @accent_fg_color;
}"

	mkdir -p -- "${_COLORSCHEME_FILE__gtk3:h}" "${_COLORSCHEME_FILE__gtk4:h}"
	echo "${css}" > "${_COLORSCHEME_FILE__gtk3}"
	echo "${css}${gtk4_accent}" > "${_COLORSCHEME_FILE__gtk4}"
}

_SET_THEME__gtk() {
	return 0  # gtk apps load gtk.css on startup
}
