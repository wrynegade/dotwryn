_COLORSCHEME_FILE__hyprland_hyprlock="$(dotwryn.config colorscheme.active.path)/hyprlock.conf"
_COLORSCHEME_FILE__hyprland_hyprtoolkit="$(dotwryn.config colorscheme.active.path)/hyprtoolkit.conf"  # linked to ~/.config/hypr by system/symlinks/get-all

_GENERATE_THEME__hyprland() {
	# (hyprland itself reads the colorscheme through colorscheme.lua; see config/desktop/hyprland/config.d/99-dwindle.lua)

	echo "# do not edit; generated by scwrypts
# theme : ${theme_name}
\$background     = rgb($(_GET_HEX .hyprland.hyprlock.background .background))
\$foreground     = rgb($(_GET_HEX .hyprland.hyprlock.foreground .foreground))
\$accent         = rgb($(_GET_HEX .hyprland.hyprlock.accent     .material.secondary.500 .ansi.green.bright))
\$accent_alt     = rgb($(_GET_HEX .hyprland.hyprlock.accent-alt .material.primary.700   .ansi.yellow.regular))
\$verifying      = rgb($(_GET_HEX .hyprland.hyprlock.verifying  .material.secondary.200 .ansi.green.bright))
\$wrong          = rgb($(_GET_HEX .hyprland.hyprlock.wrong      .material.error.200     .ansi.red.bright))
\$keypress       = rgb($(_GET_HEX .hyprland.hyprlock.keypress   .material.primary.200   .ansi.yellow.bright))
\$clock          = rgb($(_GET_HEX .hyprland.hyprlock.clock      .ansi.gray.white))
\$date           = rgb($(_GET_HEX .hyprland.hyprlock.date       .ansi.gray.bright))" > "${_COLORSCHEME_FILE__hyprland_hyprlock}"

	# shared theme for hyprland-ecosystem GUI apps (hyprland-guiutils dialogs, hyprpm prompts, ...)
	echo "# do not edit; generated by scwrypts
# theme : ${theme_name}
background       = rgb($(_GET_HEX .hyprland.hyprtoolkit.background       .material.secondary.900            .ansi.gray.black))
base             = rgb($(_GET_HEX .hyprland.hyprtoolkit.base             .material.secondary.900            .ansi.gray.black))
alternate_base   = rgb($(_GET_HEX .hyprland.hyprtoolkit.alternate-base   .background))
text             = rgb($(_GET_HEX .hyprland.hyprtoolkit.text             .material.foreground.secondary.900 .ansi.gray.white))
bright_text      = rgb($(_GET_HEX .hyprland.hyprtoolkit.bright-text      .material.foreground.primary.300   .ansi.gray.black))
accent           = rgb($(_GET_HEX .hyprland.hyprtoolkit.accent           .material.primary.300              .ansi.yellow.bright))
accent_secondary = rgb($(_GET_HEX .hyprland.hyprtoolkit.accent-secondary .material.base.primary             .ansi.yellow.regular))

font_family           = Monaspace Argon
font_family_monospace = Monaspace Argon

rounding_large = 0
rounding_small = 0" > "${_COLORSCHEME_FILE__hyprland_hyprtoolkit}"
}

_SET_THEME__hyprland() {
	command -v hyprctl &>/dev/null || return 0

	# shells that outlive a hyprland start (e.g. a tmux server started from the TTY)
	# don't carry its environment; fall back to the most recent running instance
	local -x HYPRLAND_INSTANCE_SIGNATURE="${HYPRLAND_INSTANCE_SIGNATURE:-$(
		hyprctl instances -j 2>/dev/null | jq -r 'sort_by(.time) | last | .instance // empty'
	)}"
	[[ "${HYPRLAND_INSTANCE_SIGNATURE}" ]] || return 0  # hyprland isn't running

	hyprctl reload &>/dev/null
	scwrypts --group dotwryn --type zsh --name desktop/wayland/hyprland/set-background -- theme "${theme_name}" &>/dev/null  # name.txt is written after this hook
	return 0
}
